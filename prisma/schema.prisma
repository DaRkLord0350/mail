// MAIL — cold email outreach system
// All tables live in the Postgres schema given by `?schema=` in DATABASE_URL
// (default: "mail"), so MAIL never collides with other tables in the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus { READY PENDING SENT FAILED SKIPPED }
enum CampaignStatus { DRAFT READY SCHEDULED RUNNING PAUSED COMPLETED STOPPED }
enum DeliveryStatus { PENDING PROCESSING SENT FAILED SKIPPED }
enum MissingVariableBehavior { FALLBACK REMOVE SKIP }
enum SuppressionSource { MANUAL UNSUBSCRIBE BOUNCE COMPLAINT }

model Lead {
  id String @id @default(cuid())
  email String @unique
  firstName String?
  lastName String?
  companyName String?
  displayName String?
  website String?
  customDomain String?
  phone String?
  status LeadStatus @default(READY)
  lastSentAt DateTime? @db.Timestamptz(3)
  sendCount Int @default(0)
  metadata Json @default("{}")
  importBatchId String?
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  campaignLeads CampaignLead[]
  deliveries EmailDelivery[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([status])
  @@index([companyName])
  @@index([lastSentAt])
  @@index([createdAt])
}

model ImportBatch {
  id String @id @default(cuid())
  fileName String
  columns Json
  mapping Json
  totalRows Int
  validLeads Int
  createdLeads Int
  updatedLeads Int
  invalidEmails Int
  duplicateEmails Int
  blankRows Int
  malformedRows Int
  missingNames Int
  missingCompanies Int
  alreadyContacted Int
  readyToSend Int
  issues Json @default("[]")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  leads Lead[]
}

model Template {
  id String @id @default(cuid())
  name String
  subject String
  body String
  /// Optional PDF attachment stored as base64. Raw file uploads are capped by the API.
  attachmentName String?
  attachmentMimeType String?
  attachmentData String? @db.Text
  campaigns Campaign[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Campaign {
  id String @id @default(cuid())
  name String
  templateId String?
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subjectTemplate String
  bodyTemplate String
  /// Snapshot of the template attachment so campaigns remain frozen after creation.
  attachmentName String?
  attachmentMimeType String?
  attachmentData String? @db.Text
  status CampaignStatus @default(DRAFT)
  dailyLimit Int @default(100)
  scheduledAt DateTime? @db.Timestamptz(3)
  timezone String @default("Asia/Kolkata")
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  startedAt DateTime? @db.Timestamptz(3)
  pausedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  campaignLeads CampaignLead[]
  deliveries EmailDelivery[]
  @@index([status])
  @@index([scheduledAt])
}

model CampaignLead {
  id String @id @default(cuid())
  campaignId String
  leadId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([campaignId, leadId])
  @@index([leadId])
}

model EmailDelivery {
  id String @id @default(cuid())
  campaignId String
  leadId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  email String
  renderedSubject String
  renderedBody String
  subjectTemplate String
  bodyTemplate String
  status DeliveryStatus @default(PENDING)
  providerMessageId String?
  attempts Int @default(0)
  errorMessage String?
  errorCode String?
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  lockedAt DateTime?
  lockToken String?
  errorKind String?
  idempotencyKey String?
  payload Json?
  lastAttemptAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([campaignId, leadId])
  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, lockedAt])
  @@index([leadId])
  @@index([sentAt])
  @@index([lastAttemptAt])
  @@index([createdAt])
}

model Suppression {
  id String @id @default(cuid())
  email String @unique
  reason String?
  source SuppressionSource
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model WorkerState {
  id Int @id @default(1)
  lastRunAt DateTime?
  nextSendAt DateTime?
  lastResult Json?
  haltedReason String?
  updatedAt DateTime @updatedAt
}

model Quota {
  id String @id @default(cuid())
  date DateTime @db.Date
  scope String
  sent Int @default(0)
  @@unique([date, scope])
}

model Settings {
  id Int @id @default(1)
  fromName String @default("NexVentory")
  fromEmail String @default("ventorynex@gmail.com")
  replyTo String @default("")
  dailyLimit Int @default(100)
  sendDelaySeconds Int @default(60)
  maxRetries Int @default(3)
  missingVariableBehavior MissingVariableBehavior @default(FALLBACK)
  fallbackValues Json @default("{}")
  timezone String @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestEmail {
  id String @id @default(cuid())
  to String
  leadId String
  campaignId String?
  renderedSubject String
  renderedBody String
  status String
  providerMessageId String?
  errorMessage String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
