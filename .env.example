# ─────────────────────────────────────────────────────────────
# MAIL — environment configuration
# Copy to .env and fill in. Never commit .env.
# Everything here is SERVER-ONLY. Nothing is exposed to the browser
# (no NEXT_PUBLIC_ variables are used).
# ─────────────────────────────────────────────────────────────

# Resend (https://resend.com/api-keys). Needs "Full access" for the
# connection test (it lists domains) — "Sending access" keys can still send.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. hello@yourdomain.com
FROM_EMAIL=
FROM_NAME=

# PostgreSQL. The ?schema= parameter keeps MAIL's tables in their own schema.
# Supabase: use the *session* pooler (port 5432) or a direct connection.
# If you use the transaction pooler (port 6543), append &pgbouncer=true to
# DATABASE_URL and point DIRECT_URL at the session pooler / direct host.
# connection_limit keeps each app instance well under the pooler's client cap
# (Supabase session pooler allows ~15 clients in total).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=mail&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=mail"
# Optional: only used by `npm run test:integration` (use a separate schema!)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=mail_test"

# Hard ceiling on campaign emails per day (test emails don't count).
# The Settings page can lower this but never raise it above this value.
DAILY_SEND_LIMIT=100

# Minimum spacing between two campaign emails (enforced across all workers).
DEFAULT_SEND_DELAY_SECONDS=30

# Max emails processed per worker/cron invocation, and the time budget for
# one invocation (keep below your host's function timeout).
CRON_BATCH_SIZE=10
CRON_MAX_RUNTIME_SECONDS=50

# Timezone used for the daily quota day boundary (IANA name).
APP_TIMEZONE=Asia/Kolkata

# Shared secret for /api/cron/process-email-queue
# (send as "Authorization: Bearer <CRON_SECRET>"). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Login for the MAIL dashboard (single admin user).
ADMIN_PASSWORD=
# Signs session cookies and unsubscribe links. 32+ random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: separate key for unsubscribe links. If unset, SESSION_SECRET is
# used — but then rotating SESSION_SECRET breaks links in emails already sent.
UNSUBSCRIBE_SECRET=

# Public base URL of this app (used for unsubscribe links).
APP_URL=http://localhost:3000

# Optional: run the queue worker inside the Next.js server process
# (useful for a single long-running `npm start` host without external cron).
# ENABLE_INTERNAL_WORKER=true
