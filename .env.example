# ─────────────────────────────────────────────────────────────
# MAIL — Gmail API configuration
# Copy to .env and fill in. NEVER commit .env.
# All values below are SERVER-ONLY.
# ─────────────────────────────────────────────────────────────

# Google Gmail API OAuth 2.0
# Create these in Google Cloud Console → Google Auth Platform → Clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the Authorized redirect URI configured in Google Cloud.
# Local example:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# After OAuth, store the offline refresh token here.
GOOGLE_REFRESH_TOKEN=

# Sender identity. This must be the Gmail account you authorized.
FROM_EMAIL=ventorynex@gmail.com
FROM_NAME=NexVentory

# Application safety ceiling. This does NOT increase Google's own Gmail limit.
# Google consumer Gmail accounts can impose their own daily sending limits;
# keep this at or below the limit you have verified for the account.
DAILY_SEND_LIMIT=100

# Minimum gap between campaign emails.
DEFAULT_SEND_DELAY_SECONDS=60
CRON_BATCH_SIZE=5
CRON_MAX_RUNTIME_SECONDS=50
APP_TIMEZONE=Asia/Kolkata

# Cron protection
CRON_SECRET=

# Dashboard login
ADMIN_PASSWORD=
SESSION_SECRET=
APP_URL=http://localhost:3000

# Optional long-running worker for a single server.
# ENABLE_INTERNAL_WORKER=true
